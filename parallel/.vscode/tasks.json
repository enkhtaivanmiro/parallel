{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "clang OpenMP build",
      "type": "shell",
      "command": "/usr/bin/clang++",
      "args": [
        "-std=gnu++14",
        "-Xpreprocessor",
        "-fopenmp",
        "-I/opt/homebrew/opt/libomp/include",
        "-L/opt/homebrew/opt/libomp/lib",
        "-lomp",
        "${file}",
        "-o",
        "${fileDirname}/${fileBasenameNoExtension}"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    }
  ]
}
